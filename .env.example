# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# --- SIPAAD / UTCMS Official Web Service Live Configuration ---
# Mode: 'live' for real municipal web service connection, or 'simulation' for local testing
SIPAAD_MODE="live"

# Transport Company Municipal Code (کد اختصاصی شرکت حمل‌ونقل بار شهری شما)
SIPAAD_COMPANY_CODE="24981"

# Transport Company Password in Sipaad (رمز عبور سازمانی شرکت در سامانه باربرگ)
SIPAAD_COMPANY_PASSWORD="your_company_password_here"

# Official Sipaad SOAP Endpoints (آدرس وب‌سرویس‌های رسمی سپاد/شهرداری)
SIPAAD_FREIGHTER_WS_URL="https://services2.sipaad.ir/ITMFreighter.asmx"
SIPAAD_BOL_WS_URL="https://services2.sipaad.ir/ITMBOL.asmx"

# Protocol: 'SOAP' (standard official ASMX envelope) or 'REST'
SIPAAD_PROTOCOL="SOAP"

# Web Service Request Timeout in Milliseconds
SIPAAD_TIMEOUT_MS="15000"

